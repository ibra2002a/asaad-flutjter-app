{
  "name": "vendora",
  "version": "0.1.0",
  "private": true,
  "description": "VENDORA — Arabic-first B2B wholesale marketplace (Baghdad pilot)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:flows": "node scripts/e2e-flows.mjs",
    "test:routes": "node scripts/e2e-routes.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.9",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.28",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
