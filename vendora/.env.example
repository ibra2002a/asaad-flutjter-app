# ============================================================================
# VENDORA environment template — variable NAMES only. Copy to `.env.local`
# for local development and fill in values from your Supabase project.
# NEVER commit `.env.local` or any file that contains real secrets.
# ============================================================================

# Public: your Supabase project URL (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=

# Public: the "anon" / publishable key (safe to expose; RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY: service-role key. Used only by the demo seed script and
# maintenance scripts. Must never be prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed app (used for auth redirects and links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo seed only (scripts/seed-demo.ts). Never set these in production.
# VENDORA_ALLOW_DEMO_SEED=
# DEMO_PASSWORD=
