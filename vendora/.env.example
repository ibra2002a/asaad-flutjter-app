# Copy this file to .env.local (local development) or add the same keys in Vercel
# (Project -> Settings -> Environment Variables). Never commit real values.

# Public: your Supabase project URL (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public: the anon / publishable key. Safe for browsers ONLY because RLS protects every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public: the site address used in signup/confirmation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET - server side only. Used ONLY by scripts/seed-demo.mjs on your own computer.
# Never prefix with NEXT_PUBLIC_ and never put it in Vercel's client-visible variables.
# The application code never reads this key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-only-for-local-seeding

# Local database tests only (scripts/db-test.mjs). Must point at a disposable local database.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/vendora_test
